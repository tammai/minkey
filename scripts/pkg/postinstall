#!/bin/bash
# Registers minkey for the user at the console, so it appears in Input Sources without logging out.
user=$(stat -f %Su /dev/console)
pkill -x Minkey || true
launchctl asuser "$(id -u "$user")" sudo -u "$user" "/Library/Input Methods/Minkey.app/Contents/MacOS/Minkey" --install || true
exit 0
